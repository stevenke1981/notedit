import { Button, LineEdit, TextEdit, CheckBox, ComboBox, ScrollView, ListView } from "std-widgets.slint";
import { EditorView, EdState, Theme } from "editor.slint";
export { Theme, EdState, EdTok, EdRect, EdRow, EdCaret, MapLine } from "editor.slint";
import "fonts/DejaVuSansMono.ttf";
import "fonts/DejaVuSansMono-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
export struct SearchHit { doc: int, title: string, line: int, start: int, end: int, text: string }

export struct MenuItem { label: string, shortcut: string, action: string, separator: bool, checked: bool, enabled: bool }
export struct Menu { title: string, items: [MenuItem] }
export struct TabInfo { title: string, modified: bool, w: length }
export struct SideItem { text: string, indent: int, kind: int, line: int }
export struct Block { text: string, kind: int, indent: int, bold: bool, italic: bool, code: bool, link: bool }

component ToolBtn inherits Rectangle {
    in property <image> icon; in property <string> tip;
    callback clicked;
    callback hover(string, length, bool);
    width: 24px; height: 24px; border-radius: 3px;
    background: ta.pressed ? #99c9ef : ta.has-hover ? #cce4f7 : transparent;
    border-width: ta.has-hover ? 1px : 0; border-color: #99c9ef;
    Image { source: icon; width: 16px; height: 16px; x: 4px; y: 4px; }
    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { root.hover(tip, root.absolute-position.x, self.has-hover); }
    }
}

component Sep inherits Rectangle { width: 9px; Rectangle { x: 4px; width: 1px; height: 18px; background: #c8c8c8; } }

component Dialog inherits Rectangle {
    in property <string> title;
    callback close;
    background: #f0f0f0; border-color: #888; border-width: 1px; drop-shadow-blur: 8px; drop-shadow-color: #0006;
    VerticalLayout {
        Rectangle { height: 26px; background: #dde6f2;
            HorizontalLayout { padding-left: 8px; padding-right: 4px;
                Text { text: title; vertical-alignment: center; font-weight: 700; }
                Rectangle { width: 22px; Text { text: "✕"; vertical-alignment: center; horizontal-alignment: center; }
                    TouchArea { clicked => { root.close(); } } }
            }
        }
        FocusScope {
            key-pressed(e) => { if (e.text == Key.Escape) { root.close(); return accept; } reject }
            VerticalLayout { @children }
        }
    }
}

export component AppWindow inherits Window {
    title: window-title;
    preferred-width: 1100px; preferred-height: 720px;
    icon: @image-url("icon.png");
    default-font-size: 13px;

    in property <string> window-title: "NotEdit";
    in property <string> version;
    in property <[Menu]> menus;
    in property <[TabInfo]> tabs;
    in-out property <int> current-tab: 0;
    in property <length> editor-font-size: 14px;
    in property <bool> show-preview: false;
    in property <[Block]> preview-blocks;
    in property <string> preview-title;
    in property <string> st-type: "Normal text file";
    in property <string> st-length;
    in property <string> st-pos;
    in property <string> st-eol: "Windows (CR LF)";
    in property <string> st-encoding: "UTF-8";
    in property <bool> overwrite: false;
    in-out property <bool> find-visible: false;
    in-out property <bool> replace-mode: false;
    in-out property <bool> goto-visible: false;
    // find in files
    in-out property <bool> fif-visible: false;
    in-out property <string> fif-dir;
    in-out property <string> fif-filter: "*.*";
    in-out property <bool> fif-recursive: true;
    in property <bool> fif-running: false;
    callback fif-browse();
    callback fif-run();
    callback fif-stop();
    in-out property <bool> fif-replace: false;
    callback fif-replace-all();
    callback fif-replace-undo();
    // generic one-line prompt
    in-out property <bool> prompt-visible: false;
    in property <string> prompt-title;
    in property <string> prompt-label;
    in-out property <string> prompt-text;
    callback prompt-ok(string);
    in property <bool> hex-mode: false;
    in-out property <bool> about-visible: false;
    in property <string> find-status;
    in-out property <string> find-text;
    in-out property <string> replace-text;
    in-out property <bool> match-case: false;
    in property <int> total-lines: 1;
    in property <bool> dark: false;
    in property <[SearchHit]> hits;
    in property <string> hits-title;
    in-out property <bool> hits-visible: false;
    in-out property <bool> whole-word: false;
    in-out property <bool> use-regex: false;
    in property <bool> macro-recording: false;
    in property <[MenuItem]> ctx-items;
    in-out property <bool> ctx-visible: false;
    in-out property <bool> rename-visible: false;
    in-out property <string> rename-text;
    property <length> ctx-x; property <length> ctx-y;
    property <color> c-chrome: Theme.chrome;
    property <color> c-menu: Theme.menu;
    property <color> c-fg: Theme.fg;
    property <color> c-editor: Theme.editor-bg;
    property <color> c-gutter: Theme.gutter;
    property <color> c-gutter-fg: Theme.gutter-fg;
    property <color> c-curline: Theme.curline;
    property <color> c-tabbar: Theme.tabbar;
    property <color> c-tab: Theme.tab;
    property <color> c-tab-active: Theme.tab-active;
    property <color> c-border: Theme.border;
    property <color> c-hover: Theme.hover;
    property <int> drag-from: -1;
    property <int> drop-target: -1;
    property <length> drag-abs-x;
    in property <string> mono: "JetBrains Mono";
    // sidebar: 0 = hidden, 1 = folder workspace, 2 = function list
    in property <int> side-mode: 0;
    in property <[SideItem]> side-items;
    in property <string> side-title;
    in property <int> side-sel: -1;
    callback side-click(int);
    callback side-activate(int);
    callback side-switch(int);
    callback side-open-folder();
    callback custom-key(string, bool, bool, bool) -> bool;
    in property <EdState> v0;
    in property <EdState> v1;
    in property <bool> split: false;
    in property <bool> docmap: false;
    in property <int> active-view: 0;
    out property <length> cell-w: metric.preferred-width / 20;
    out property <length> line-h: metric.preferred-height;
    out property <length> v0-w: ev0.text-w;
    out property <length> v0-h: ev0.text-h;
    out property <length> v1-w: ev1.text-w;
    out property <length> v1-h: ev1.text-h;
    callback layout-changed();
    /// set after ~10 s without activity: the caret is drawn statically (no blink redraws)
    in property <bool> caret-idle: false;
    changed v0-w => { layout-changed(); }
    changed v0-h => { layout-changed(); }
    changed v1-w => { layout-changed(); }
    changed v1-h => { layout-changed(); }
    changed cell-w => { layout-changed(); }
    changed line-h => { layout-changed(); }
    callback ed-key(int, string, bool, bool, bool) -> bool;
    callback ed-input(int, string);
    callback ed-mouse(int, int, length, length, bool, bool, bool);
    callback ed-gutter(int, int, bool, bool);
    callback ed-wheel(int, length, length, bool, bool);
    callback ed-vscroll(int, float);
    callback ed-hscroll(int, float);
    callback ed-ac-pick(int, int);
    callback ed-map(int, float);
    callback ed-focused(int);
    callback tab-target(int, length) -> int;

    callback menu-action(string);
    callback tab-selected(int);
    callback tab-close(int);
    callback find-next(bool);
    callback replace-one();
    callback replace-all();
    callback goto-line(string);
    callback count-matches();
    callback link-clicked(string);
    callback context-request(string, int);
    callback rename-accepted(string);
    callback tab-move(int, int);
    callback find-all();
    callback hit-clicked(int);
    in-out property <bool> ai-visible: false;
    in-out property <int> ai-page: 0;
    in-out property <int> ai-role: 0;
    in-out property <int> ai-language: 0;
    in-out property <string> ai-language-custom;
    in-out property <int> ai-mode: 0;
    in-out property <string> ai-key;
    in-out property <string> ai-key-status;
    in-out property <string> ai-model: "openrouter/free";
    in-out property <string> ai-prompt;
    in-out property <string> ai-result;
    in-out property <string> ai-status;
    in-out property <bool> ai-include-document: false;
    in-out property <bool> ai-running: false;
    in-out property <string> ai-source;
    in-out property <string> ai-source-title;
    in-out property <bool> ai-has-source: false;
    in-out property <string> ai-history;
    callback ai-send();
    callback ai-apply(bool);
    callback ai-save-key();
    callback ai-use-key();
    callback ai-clear-key();

    public function focus-editor() { if (split && active-view == 1) { ev1.focus-in(); } else { ev0.focus-in(); } }

    in-out property <int> open-menu: -1;
    property <string> tip-text; property <length> tip-x; property <bool> tip-on;
    function show-tip(t: string, x: length, h: bool) { tip-text = t; tip-x = x; tip-on = h; }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (custom-key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) { return accept; }
            if (e.modifiers.control && !e.modifiers.alt) {
                if ((e.text == "r" || e.text == "R") && e.modifiers.shift) { menu-action("macrorec"); return accept; }
                if ((e.text == "p" || e.text == "P") && e.modifiers.shift) { menu-action("macroplay"); return accept; }
                if ((e.text == "s" || e.text == "S") && e.modifiers.shift) { menu-action("saveas"); return accept; }
                if ((e.text == "f" || e.text == "F") && e.modifiers.shift) { menu-action("fif"); return accept; }
                if (e.text == "s") { menu-action("save"); return accept; }
                if (e.text == "o") { menu-action("open"); return accept; }
                if (e.text == "n") { menu-action("new"); return accept; }
                if (e.text == "w") { menu-action("close"); return accept; }
                if (e.text == "f") { menu-action("find"); return accept; }
                if (e.text == "h") { menu-action("replace"); return accept; }
                if (e.text == "g") { menu-action("goto"); return accept; }
                if (e.text == "z") { menu-action("undo"); return accept; }
                if (e.text == "y") { menu-action("redo"); return accept; }
                if (e.text == "d") { menu-action("dupline"); return accept; }
                if (e.text == "q") { menu-action("comment"); return accept; }
                if (e.text == "+" || e.text == "=") { menu-action("zoomin"); return accept; }
                if (e.text == "-") { menu-action("zoomout"); return accept; }
                if (e.text == "0") { menu-action("zoomreset"); return accept; }
                if (e.text == Key.Tab) { menu-action("nexttab"); return accept; }
            }
            if (e.modifiers.control && e.modifiers.alt && (e.text == "f" || e.text == "F")) { menu-action("foldcur"); return accept; }
            if (e.modifiers.alt && !e.modifiers.control && (e.text == "0" || e.text == ")")) { menu-action(e.modifiers.shift ? "unfoldall" : "foldall"); return accept; }
            if (e.modifiers.alt && !e.modifiers.control && (e.text == "h" || e.text == "H")) { menu-action(hex-mode ? "textmode" : "hexmode"); return accept; }
            if (e.modifiers.alt && !e.modifiers.control && (e.text == "c" || e.text == "C")) { menu-action("columnmode"); return accept; }
            if (e.text == Key.F8) { menu-action("otherview"); return accept; }
            if (e.text == Key.F7) { menu-action(e.modifiers.shift ? "diffprev" : "diffnext"); return accept; }
            if (e.text == Key.F3) { find-next(!e.modifiers.shift); return accept; }
            if (e.text == Key.Insert) { menu-action("toggleovr"); return accept; }
            if (e.text == Key.Escape) { fif-visible = false; prompt-visible = false; find-visible = false; goto-visible = false; hits-visible = false; about-visible = false; open-menu = -1; ctx-visible = false; rename-visible = false; focus-editor(); return accept; }
            reject
        }

    VerticalLayout {
        // ---- menu bar ----
        Rectangle { height: 22px; background: c-menu;
            HorizontalLayout { padding-left: 2px;
                for m[i] in menus: Rectangle {
                    width: mt.preferred-width + 14px;
                    background: open-menu == i || mta.has-hover ? c-hover : transparent;
                    mt := Text { color: c-fg; text: m.title; vertical-alignment: center; horizontal-alignment: center; }
                    mta := TouchArea {
                        clicked => { open-menu = open-menu == i ? -1 : i; }
                        moved => { }
                    }
                }
                Rectangle {}
            }
        }
        // ---- toolbar ----
        Rectangle { height: 30px; background: c-chrome; border-color: #ddd; border-width: 0;
            HorizontalLayout { padding: 3px; spacing: 1px;
                ToolBtn { icon: @image-url("icons/new.svg"); tip: "開新檔案 (Ctrl+N)"; clicked => { menu-action("new"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/open.svg"); tip: "開啟舊檔 (Ctrl+O)"; clicked => { menu-action("open"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/save.svg"); tip: "儲存檔案 (Ctrl+S)"; clicked => { menu-action("save"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/saveall.svg"); tip: "全部儲存"; clicked => { menu-action("saveall"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/close.svg"); tip: "關閉 (Ctrl+W)"; clicked => { menu-action("close"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/closeall.svg"); tip: "全部關閉"; clicked => { menu-action("closeall"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/print.svg"); tip: "列印 (以瀏覽器開啟可列印的 HTML)"; clicked => { menu-action("print"); } hover(t, x, h) => { show-tip(t, x, h); } }
                Sep {}
                ToolBtn { icon: @image-url("icons/cut.svg"); tip: "剪下 (Ctrl+X)"; clicked => { menu-action("cut"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/copy.svg"); tip: "複製 (Ctrl+C)"; clicked => { menu-action("copy"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/paste.svg"); tip: "貼上 (Ctrl+V)"; clicked => { menu-action("paste"); } hover(t, x, h) => { show-tip(t, x, h); } }
                Sep {}
                ToolBtn { icon: @image-url("icons/undo.svg"); tip: "復原 (Ctrl+Z)"; clicked => { menu-action("undo"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/redo.svg"); tip: "取消復原 (Ctrl+Y)"; clicked => { menu-action("redo"); } hover(t, x, h) => { show-tip(t, x, h); } }
                Sep {}
                ToolBtn { icon: @image-url("icons/find.svg"); tip: "尋找 (Ctrl+F)"; clicked => { menu-action("find"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/replace.svg"); tip: "取代 (Ctrl+H)"; clicked => { menu-action("replace"); } hover(t, x, h) => { show-tip(t, x, h); } }
                Sep {}
                ToolBtn { icon: @image-url("icons/zoomin.svg"); tip: "放大 (Ctrl++)"; clicked => { menu-action("zoomin"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/zoomout.svg"); tip: "縮小 (Ctrl+-)"; clicked => { menu-action("zoomout"); } hover(t, x, h) => { show-tip(t, x, h); } }
                Sep {}
                ToolBtn { icon: @image-url("icons/wrap.svg"); tip: "自動換行"; clicked => { menu-action("wrap"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/linenumbers.svg"); tip: "顯示行號"; clicked => { menu-action("linenumbers"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/selectall.svg"); tip: "全選 (Ctrl+A)"; clicked => { menu-action("selectall"); } hover(t, x, h) => { show-tip(t, x, h); } }
                ToolBtn { icon: @image-url("icons/preview.svg"); tip: "HTML / Markdown 預覽"; clicked => { menu-action("preview"); } hover(t, x, h) => { show-tip(t, x, h); } }
                Rectangle { width: 64px; background: ai-visible ? c-hover : aita.has-hover ? c-hover : transparent;
                    Text { text: "AI 助手"; color: c-fg; horizontal-alignment: center; vertical-alignment: center; }
                    aita := TouchArea { clicked => { ai-visible = !ai-visible; } }
                }
                Rectangle {}
            }
        }
        // ---- tabs ----
        Rectangle { height: 26px; background: c-tabbar;
            HorizontalLayout { padding-left: 2px; spacing: 1px; alignment: start;
                for t[i] in tabs: Rectangle {
                    width: t.w;
                    background: i == current-tab ? c-tab-active : tta.has-hover ? c-hover : c-tab;
                    border-width: 1px; border-color: c-border;
                    property <bool> drop-here: drag-from >= 0 && drag-from != i && drop-target == i;
                    Rectangle { y: 0; height: 3px; background: i == current-tab ? #f7a535 : transparent; }
                    Rectangle { x: drag-from > i ? 0 : parent.width - 3px; width: 3px; background: drop-here ? #2a6fc9 : transparent; }
                    tta := TouchArea {
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                ctx-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                ctx-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                open-menu = -1;
                                context-request("tab", i);
                            }
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { tab-selected(i); drag-from = i; drop-target = i; drag-abs-x = self.mouse-x; }
                            if (ev.kind == PointerEventKind.up && drag-from >= 0) {
                                if (drop-target >= 0 && drop-target != drag-from) { tab-move(drag-from, drop-target); }
                                drag-from = -1; drop-target = -1;
                            }
                        }
                        moved => {
                            if (drag-from >= 0) {
                                drop-target = tab-target(drag-from, self.mouse-x - drag-abs-x);
                            }
                        }
                    }
                    HorizontalLayout { padding-left: 6px; padding-right: 4px; spacing: 4px;
                        Text { text: t.modified ? "●" : "○"; color: t.modified ? #d32 : #3a3; vertical-alignment: center; }
                        tt := Text { color: c-fg; text: t.title; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-weight: i == current-tab ? 700 : 400; }
                        Rectangle { width: 16px;
                            Text { text: "✕"; vertical-alignment: center; horizontal-alignment: center; color: xa.has-hover ? #d00 : #777; }
                            xa := TouchArea { clicked => { tab-close(i); } } }
                    }
                }
            }
        }
        // ---- editor + preview ----
        HorizontalLayout {
            metric := Text { visible: false; width: 0; text: "MMMMMMMMMMMMMMMMMMMM"; font-family: mono; font-size: editor-font-size; }
            if side-mode > 0: Rectangle { width: 240px; background: c-editor;
                VerticalLayout {
                    Rectangle { height: 24px; background: c-chrome;
                        HorizontalLayout { padding-left: 2px; padding-right: 2px; spacing: 2px;
                            for t[ti] in ["資料夾", "函式清單"]: Rectangle {
                                width: stt.preferred-width + 14px;
                                background: side-mode == ti + 1 ? c-tab-active : sta.has-hover ? c-hover : transparent;
                                stt := Text { text: t; color: c-fg; vertical-alignment: center; horizontal-alignment: center; font-weight: side-mode == ti + 1 ? 700 : 400; }
                                sta := TouchArea { clicked => { side-switch(ti + 1); } }
                            }
                            Rectangle {}
                            if side-mode == 1: Rectangle { width: 22px; background: sfa.has-hover ? c-hover : transparent;
                                Text { text: "📂"; color: c-fg; vertical-alignment: center; horizontal-alignment: center; }
                                sfa := TouchArea { clicked => { side-open-folder(); } } }
                            Rectangle { width: 20px; Text { text: "✕"; color: c-fg; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { side-switch(0); } } }
                        }
                    }
                    Rectangle { height: 20px; background: c-chrome;
                        Text { x: 6px; width: parent.width - 8px; text: side-title; color: c-gutter-fg; vertical-alignment: center; overflow: elide; font-size: 12px; } }
                    ListView {
                        for it[i] in side-items: Rectangle { height: 20px;
                            background: i == side-sel ? c-curline : sia.has-hover ? c-hover : transparent;
                            HorizontalLayout { padding-left: 4px + it.indent * 14px; spacing: 4px;
                                Text { width: 12px; color: c-gutter-fg; vertical-alignment: center;
                                    text: it.kind == 1 ? "▸" : it.kind == 2 ? "▾" : ""; }
                                Text { width: 14px; vertical-alignment: center; color: it.kind == 3 ? #a35cc6 : c-gutter-fg; font-size: 11px;
                                    text: it.kind == 0 ? "📄" : it.kind == 3 ? "ƒ" : it.kind == 4 ? "#" : "📁"; }
                                Text { text: it.text; color: c-fg; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-family: it.kind >= 3 ? mono : ""; }
                            }
                            sia := TouchArea { clicked => { side-click(i); } double-clicked => { side-activate(i); } }
                        }
                    }
                }
            }
            if side-mode > 0: Rectangle { width: 1px; background: c-border; }
            ev0 := EditorView {
                horizontal-stretch: 1;
                st: v0; line-h: line-h; cell-w: cell-w; font-size: editor-font-size; mono: mono; dark: dark; overwrite: overwrite; caret-idle: caret-idle;
                map-visible: docmap && !split; active: !split || active-view == 0;
                key(t, c, s, a) => { ed-key(0, t, c, s, a) }
                input(t) => { ed-input(0, t); }
                mouse(k, x, y, c, s, a) => { ed-mouse(0, k, x, y, c, s, a); }
                gutter(r, f, s) => { ed-gutter(0, r, f, s); }
                wheel(dx, dy, s, c) => { ed-wheel(0, dx, dy, s, c); }
                vscroll(f) => { ed-vscroll(0, f); }
                hscroll(f) => { ed-hscroll(0, f); }
                ac-pick(i) => { ed-ac-pick(0, i); }
                map-click(f) => { ed-map(0, f); }
                focused => { ed-focused(0); }
                context(x, y) => { ctx-x = x - root.absolute-position.x; ctx-y = y - root.absolute-position.y; open-menu = -1; context-request("editor", 0); }
            }
            Rectangle { width: split ? 4px : 0px; background: c-border; }
            ev1 := EditorView {
                horizontal-stretch: split ? 1 : 0; max-width: split ? 100000px : 0px; visible: split;
                st: v1; line-h: line-h; cell-w: cell-w; font-size: editor-font-size; mono: mono; dark: dark; overwrite: overwrite; caret-idle: caret-idle;
                map-visible: false; active: active-view == 1;
                key(t, c, s, a) => { ed-key(1, t, c, s, a) }
                input(t) => { ed-input(1, t); }
                mouse(k, x, y, c, s, a) => { ed-mouse(1, k, x, y, c, s, a); }
                gutter(r, f, s) => { ed-gutter(1, r, f, s); }
                wheel(dx, dy, s, c) => { ed-wheel(1, dx, dy, s, c); }
                vscroll(f) => { ed-vscroll(1, f); }
                hscroll(f) => { ed-hscroll(1, f); }
                ac-pick(i) => { ed-ac-pick(1, i); }
                map-click(f) => { ed-map(1, f); }
                focused => { ed-focused(1); }
                context(x, y) => { ctx-x = x - root.absolute-position.x; ctx-y = y - root.absolute-position.y; open-menu = -1; context-request("editor", 1); }
            }
            if ai-visible: Rectangle { width: 1px; background: c-border; }
            if ai-visible: Rectangle {
                width: 360px; background: c-editor;
                VerticalLayout {
                    Rectangle { height: 28px; background: c-chrome;
                        HorizontalLayout { padding-left: 5px; padding-right: 4px; spacing: 2px;
                            for label[i] in ["對話", "結果", "設定"]: Rectangle {
                                width: 64px; background: ai-page == i ? c-tab-active : aipa.has-hover ? c-hover : transparent;
                                Text { text: label; color: c-fg; horizontal-alignment: center; vertical-alignment: center; font-weight: ai-page == i ? 700 : 400; }
                                aipa := TouchArea { clicked => { ai-page = i; } }
                            }
                            Rectangle {}
                            Rectangle { width: 24px;
                                Text { text: "✕"; color: c-fg; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { ai-visible = false; focus-editor(); } }
                            }
                        }
                    }
                    if ai-page == 0: VerticalLayout { padding: 8px; spacing: 6px;
                        HorizontalLayout { spacing: 6px;
                            Text { text: "角色"; color: c-fg; vertical-alignment: center; }
                            ComboBox { model: ["通用助手", "校稿", "翻譯", "文字潤飾", "摘要", "格式整理"]; current-index <=> ai-role; }
                        }
                        if ai-role == 2: HorizontalLayout { spacing: 6px;
                            Text { text: "翻譯語言"; color: c-fg; vertical-alignment: center; }
                            ComboBox { model: ["繁體中文（台灣）", "簡體中文", "英文", "日文", "韓文", "越南文", "泰文", "印尼文", "法文", "德文", "西班牙文", "自訂語言"]; current-index <=> ai-language; }
                        }
                        if ai-role == 2 && ai-language == 11: LineEdit { text <=> ai-language-custom; placeholder-text: "輸入目標語言，例如葡萄牙文"; }
                        Text { text: "對話紀錄"; color: c-fg; }
                        TextEdit { text: ai-history; read-only: true; wrap: word-wrap; vertical-stretch: 1; placeholder-text: "在下方輸入需求，開始與 AI 對話。"; }
                        Text { text: "指令"; color: c-fg; }
                        TextEdit { text <=> ai-prompt; height: 75px; wrap: word-wrap; placeholder-text: "例如：整理目前文章或建立 JSON"; }
                        CheckBox { text: "傳送目前文件內容"; checked <=> ai-include-document; }
                        ComboBox { model: ["僅預覽", "自動建立新檔", "自動備份並修改目前檔案"]; current-index <=> ai-mode; enabled: !ai-running; }
                        Text { text: "先前對話會傳送至 OpenRouter；自動修改會傳送目前文件。"; color: c-gutter-fg; wrap: word-wrap; }
                        HorizontalLayout { spacing: 6px;
                            Button { text: "送出"; enabled: !ai-running; clicked => { ai-send(); } }
                            Button { text: "清除對話"; enabled: !ai-running; clicked => { ai-history = ""; ai-result = ""; ai-status = "已清除對話"; ai-has-source = false; } }
                        }
                        Text { text: ai-status; color: c-fg; wrap: word-wrap; }
                    }
                    if ai-page == 1: VerticalLayout { padding: 8px; spacing: 6px;
                        Text { text: "回覆預覽（可自行修改）"; color: c-fg; }
                        TextEdit { text <=> ai-result; font-family: root.mono; vertical-stretch: 1; }
                        HorizontalLayout { spacing: 6px;
                            Button { text: "套用至目前文件"; enabled: !ai-running && !ai-result.is-empty; clicked => { ai-apply(false); } }
                            Button { text: "建立新文件"; enabled: !ai-running && !ai-result.is-empty; clicked => { ai-apply(true); } }
                        }
                        Text { text: ai-status; color: c-fg; wrap: word-wrap; }
                    }
                    if ai-page == 2: VerticalLayout { padding: 8px; spacing: 8px; alignment: start;
                        Text { text: "OpenRouter API 金鑰"; color: c-fg; wrap: word-wrap; }
                        LineEdit { text <=> ai-key; input-type: password; placeholder-text: "OpenRouter API key"; }
                        HorizontalLayout { spacing: 6px;
                            Button { text: "儲存金鑰"; clicked => { ai-save-key(); } }
                            Button { text: "本次使用"; clicked => { ai-use-key(); } }
                            Button { text: "刪除已存金鑰"; clicked => { ai-clear-key(); } }
                        }
                        Text { text: ai-key-status; color: c-fg; wrap: word-wrap; }
                        Text { text: "Windows 使用目前帳戶加密保存；儲存後才會套用。"; color: c-gutter-fg; wrap: word-wrap; }
                        Text { text: "免費模型"; color: c-fg; }
                        LineEdit { text <=> ai-model; placeholder-text: "openrouter/free 或模型名稱:free"; }
                        Text { text: "僅支援 openrouter/free 或以 :free 結尾的模型。"; color: c-gutter-fg; wrap: word-wrap; }
                    }
                }
            }
            if show-preview: Rectangle { width: 1px; background: #aaa; }
            if show-preview: Rectangle { horizontal-stretch: 1; background: #fbfbfb;
                VerticalLayout {
                    Rectangle { height: 22px; background: #e9eef5;
                        Text { x: 6px; text: "預覽：" + preview-title; vertical-alignment: center; font-weight: 700; } }
                    ScrollView {
                        VerticalLayout { padding: 12px; spacing: 6px; alignment: start;
                            for b in preview-blocks: Rectangle {
                                background: b.kind == 10 ? #f0f0f0 : b.kind == 12 ? #f5f5f5 : transparent;
                                border-width: b.kind == 10 ? 1px : 0; border-color: #ddd;
                                HorizontalLayout { padding-left: b.indent * 18px + (b.kind == 10 ? 8px : 0) + (b.kind == 12 ? 14px : 0); padding-top: b.kind == 10 ? 6px : 0; padding-bottom: b.kind == 10 ? 6px : 0;
                                    if b.kind == 12: Rectangle { width: 3px; background: #bbb; }
                                    if b.kind == 11: Rectangle { height: 1px; background: #ccc; }
                                    if b.kind != 11: Text {
                                        text: b.text; wrap: b.kind == 10 ? TextWrap.no-wrap : TextWrap.word-wrap;
                                        font-size: b.kind == 1 ? 26px : b.kind == 2 ? 21px : b.kind == 3 ? 18px : b.kind >= 4 && b.kind <= 6 ? 15px : 14px;
                                        font-weight: (b.kind >= 1 && b.kind <= 6) || b.bold ? 700 : 400;
                                        font-italic: b.italic;
                                        font-family: b.kind == 10 || b.code ? mono : "";
                                        color: b.link ? #0645ad : b.kind == 12 ? #555 : #222;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // ---- status bar ----
        if hits-visible: Rectangle { height: 160px; background: c-editor; border-color: c-border; border-width: 1px;
            VerticalLayout {
                Rectangle { height: 22px; background: c-chrome;
                    HorizontalLayout { padding-left: 6px; padding-right: 4px;
                        Text { color: c-fg; text: hits-title; vertical-alignment: center; font-weight: 700; }
                        Rectangle { width: 20px; Text { color: c-fg; text: "✕"; vertical-alignment: center; horizontal-alignment: center; }
                            TouchArea { clicked => { hits-visible = false; } } }
                    }
                }
                ListView {
                    for h[i] in hits: Rectangle { height: 20px; background: ha.has-hover ? c-hover : transparent;
                        HorizontalLayout { padding-left: 8px; spacing: 8px;
                            Text { color: #2a7a2a; text: h.title; vertical-alignment: center; }
                            Text { color: #a06000; text: "第 " + h.line + " 行"; vertical-alignment: center; width: 70px; }
                            Text { color: c-fg; text: h.text; vertical-alignment: center; font-family: mono; overflow: elide; horizontal-stretch: 1; }
                        }
                        ha := TouchArea { clicked => { hit-clicked(i); } }
                    }
                }
            }
        }
        Rectangle { height: 22px; background: c-chrome; border-color: c-border; border-width: 1px;
            HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 0;
                Text { color: macro-recording ? #e33 : c-fg; text: (macro-recording ? "● 巨集錄製中   " : "") + st-type; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle { width: 1px; background: c-border; }
                Text { color: c-fg; text: st-length; vertical-alignment: center; width: 230px; horizontal-alignment: center; }
                Rectangle { width: 1px; background: c-border; }
                Text { color: c-fg; text: st-pos; vertical-alignment: center; width: 260px; horizontal-alignment: center; }
                Rectangle { width: 1px; background: c-border; }
                Text { color: c-fg; text: st-eol; vertical-alignment: center; width: 120px; horizontal-alignment: center; }
                Rectangle { width: 1px; background: c-border; }
                Text { color: c-fg; text: st-encoding; vertical-alignment: center; width: 110px; horizontal-alignment: center; }
                Rectangle { width: 1px; background: c-border; }
                Text { color: c-fg; text: overwrite ? "OVR" : "INS"; vertical-alignment: center; width: 40px; horizontal-alignment: center; }
            }
        }
    }
    }

    if tip-on && open-menu < 0: Rectangle {
        x: min(tip-x, root.width - tipt.preferred-width - 12px); y: 54px; width: tipt.preferred-width + 10px; height: 20px;
        background: #ffffe1; border-color: #767676; border-width: 1px;
        tipt := Text { color: c-fg; text: tip-text; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
    }
    // ---- open menu dropdown ----
    if open-menu >= 0: TouchArea { clicked => { open-menu = -1; } }
    if open-menu >= 0: Rectangle {
        x: menu-x(open-menu); y: 22px; width: 300px;
        height: dd.preferred-height;
        background: dark ? #2d2d30 : #f9f9f9; border-color: c-border; border-width: 1px; drop-shadow-blur: 6px; drop-shadow-color: #0005;
        dd := VerticalLayout { padding: 2px;
            for it in menus[open-menu].items: Rectangle {
                height: it.separator ? 7px : 22px;
                background: !it.separator && it.enabled && ia.has-hover ? c-hover : transparent;
                if it.separator: Rectangle { y: 3px; height: 1px; background: #ccc; }
                if !it.separator: HorizontalLayout { padding-left: 4px; padding-right: 10px;
                    Text { color: c-fg; width: 20px; text: it.checked ? "✓" : ""; vertical-alignment: center; }
                    Text { color: it.enabled ? c-fg : c-gutter-fg; text: it.label; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: it.shortcut; vertical-alignment: center; color: c-gutter-fg; }
                }
                ia := TouchArea { enabled: !it.separator && it.enabled; clicked => { menu-action(it.action); open-menu = -1; } }
            }
        }
    }

    // approximate x of each menu title (CJK title widths)
    pure function menu-x(i: int) -> length { i * 32px + 2px }

    // ---- find / replace ----
    if find-visible: Dialog {
        title: replace-mode ? "取代" : "尋找"; x: parent.width - 580px; y: 90px; width: 560px; height: replace-mode ? 236px : 196px;
        close => { find-visible = false; focus-editor(); }
        VerticalLayout { padding: 10px; spacing: 6px;
            HorizontalLayout { spacing: 6px;
                Text { text: "尋找目標："; width: 70px; vertical-alignment: center; }
                fe := LineEdit { text <=> find-text; accepted => { find-next(true); } init => { self.focus(); } }
            }
            if replace-mode: HorizontalLayout { spacing: 6px;
                Text { text: "取代為："; width: 70px; vertical-alignment: center; }
                LineEdit { text <=> replace-text; }
            }
            HorizontalLayout { spacing: 6px;
                CheckBox { text: "大小寫須相符"; checked <=> match-case; }
                CheckBox { text: "全字拼寫須相符"; checked <=> whole-word; }
                CheckBox { text: "規則運算式"; checked <=> use-regex; }
            }
            HorizontalLayout { spacing: 6px;
                CheckBox { text: "取代模式"; checked <=> replace-mode; }
            }
            HorizontalLayout { spacing: 4px;
                Button { text: "找下一個"; clicked => { find-next(true); } }
                Button { text: "找上一個"; clicked => { find-next(false); } }
                Button { text: "計數"; clicked => { count-matches(); } }
                Button { text: "在所有開啟文件中尋找"; clicked => { find-all(); } }
                if replace-mode: Button { text: "取代"; clicked => { replace-one(); } }
                if replace-mode: Button { text: "全部取代"; clicked => { replace-all(); } }
            }
            Text { text: find-status; color: #a33; }
        }
    }

    if fif-visible: Dialog {
        title: fif-replace ? "在檔案中取代" : "在檔案中尋找"; x: (parent.width - 640px) / 2; y: 90px; width: 640px; height: fif-replace ? 276px : 236px;
        close => { fif-visible = false; focus-editor(); }
        VerticalLayout { padding: 10px; spacing: 6px;
            HorizontalLayout { spacing: 6px;
                Text { text: "尋找目標："; width: 70px; vertical-alignment: center; }
                LineEdit { text <=> find-text; accepted => { fif-run(); } init => { self.focus(); } }
            }
            if fif-replace: HorizontalLayout { spacing: 6px;
                Text { text: "取代為："; width: 70px; vertical-alignment: center; }
                LineEdit { text <=> replace-text; }
            }
            HorizontalLayout { spacing: 6px;
                Text { text: "資料夾："; width: 70px; vertical-alignment: center; }
                LineEdit { text <=> fif-dir; }
                Button { text: "瀏覽..."; clicked => { fif-browse(); } }
            }
            HorizontalLayout { spacing: 6px;
                Text { text: "檔案類型："; width: 70px; vertical-alignment: center; }
                LineEdit { text <=> fif-filter; placeholder-text: "*.rs;*.txt"; }
            }
            HorizontalLayout { spacing: 6px;
                CheckBox { text: "包含子資料夾"; checked <=> fif-recursive; }
                CheckBox { text: "大小寫須相符"; checked <=> match-case; }
                CheckBox { text: "全字拼寫須相符"; checked <=> whole-word; }
                CheckBox { text: "規則運算式"; checked <=> use-regex; }
            }
            HorizontalLayout { spacing: 4px;
                Button { text: fif-replace ? "預覽" : "全部尋找"; enabled: !fif-running; clicked => { fif-run(); } }
                if fif-replace: Button { text: "全部取代..."; enabled: !fif-running; clicked => { fif-replace-all(); } }
                if fif-replace: Button { text: "復原檔案取代"; clicked => { fif-replace-undo(); } }
                CheckBox { text: "取代"; checked <=> fif-replace; }
                Button { text: "停止"; enabled: fif-running; clicked => { fif-stop(); } }
                Text { text: find-status; color: #a33; vertical-alignment: center; }
            }
        }
    }

    if prompt-visible: Dialog {
        title: prompt-title; x: (parent.width - 380px) / 2; y: 120px; width: 380px; height: 130px;
        close => { prompt-visible = false; focus-editor(); }
        VerticalLayout { padding: 10px; spacing: 8px;
            Text { text: prompt-label; }
            pe := LineEdit { text <=> prompt-text; accepted(t) => { prompt-visible = false; prompt-ok(t); } init => { self.focus(); } }
            Button { text: "確定"; clicked => { prompt-visible = false; prompt-ok(pe.text); } }
        }
    }

    if goto-visible: Dialog {
        title: "跳至..."; x: (parent.width - 320px) / 2; y: 120px; width: 320px; height: 130px;
        close => { goto-visible = false; focus-editor(); }
        VerticalLayout { padding: 10px; spacing: 8px;
            Text { text: "行號 (1 - " + total-lines + ")："; }
            ge := LineEdit { accepted(t) => { goto-line(t); } init => { self.focus(); } }
            Button { text: "跳至"; clicked => { goto-line(ge.text); } }
        }
    }

    if about-visible: Dialog {
        title: "關於 NotEdit"; x: (parent.width - 360px) / 2; y: 150px; width: 360px; height: 160px;
        close => { about-visible = false; focus-editor(); }
        VerticalLayout { padding: 14px; spacing: 6px;
            Text { text: "NotEdit " + version; font-size: 18px; font-weight: 700; }
            Text { text: "以 Rust + Slint 製作的類 Notepad++ 文字編輯器"; }
            Text { text: "支援 HTML / Markdown 預覽"; }
            Button { text: "確定"; clicked => { about-visible = false; } }
        }
    }

    // ---- context menu ----
    if ctx-visible: TouchArea {
        pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { ctx-visible = false; } }
    }
    if ctx-visible: Rectangle {
        width: 250px; height: cl.preferred-height;
        x: max(0px, min(ctx-x, root.width - self.width - 2px));
        y: max(0px, min(ctx-y, root.height - self.height - 2px));
        background: dark ? #2d2d30 : #f9f9f9; border-color: c-border; border-width: 1px; drop-shadow-blur: 6px; drop-shadow-color: #0005;
        cl := VerticalLayout { padding: 2px;
            for it in ctx-items: Rectangle {
                height: it.separator ? 7px : 22px;
                background: !it.separator && it.enabled && ca.has-hover ? c-hover : transparent;
                if it.separator: Rectangle { y: 3px; height: 1px; background: c-border; }
                if !it.separator: HorizontalLayout { padding-left: 24px; padding-right: 10px;
                    Text { color: it.enabled ? c-fg : c-gutter-fg; text: it.label; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: it.shortcut; vertical-alignment: center; color: c-gutter-fg; }
                }
                ca := TouchArea { enabled: !it.separator && it.enabled; clicked => { menu-action(it.action); ctx-visible = false; } }
            }
        }
    }

    if rename-visible: Dialog {
        title: "重新命名"; x: (parent.width - 380px) / 2; y: 140px; width: 380px; height: 130px;
        close => { rename-visible = false; focus-editor(); }
        VerticalLayout { padding: 10px; spacing: 8px;
            Text { text: "新的檔名："; }
            re := LineEdit { text <=> rename-text; accepted(t) => { rename-accepted(t); } init => { self.focus(); } }
            Button { text: "確定"; clicked => { rename-accepted(re.text); } }
        }
    }
}
